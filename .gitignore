# os / editor
.DS_Store
.vscode/
.idea/

# env / secrets
.env
.env.*
*.pem
secrets/

# deps / build
node_modules/
dist/
build/
target/
.venv/
__pycache__/
*.pyc

# logs / temp
*.log
tmp/
.cache/

# workbuddy 本地记忆（不入库）
.workbuddy/

# 生成的场景资产（由 tools/scene2glb.py + Blender 从 source/data/scene.gz 重建）
web/public/assets/scene.glb
web/public/assets/scene_new.glb
web/public/assets/v07_scene.glb
web/public/assets/catalog.json

# 用户原始素材（CAD/照片/压缩包，本地保留，不入库）
assets-source/

# 后端依赖与运行时数据（含密钥、口令哈希、上传文件）
server/node_modules/
server/data/

# 构建中间件（V07 转换件、Blender 输出），发布前拷到 web/public/assets/scene.glb
assets-build/

# 发布包（由 web/dist + server 组装，构建产物）
deploy/
